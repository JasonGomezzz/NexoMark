# ============================================================
# MarketMind IA — Variables de Entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitear el .env al repositorio.
# ============================================================


# ─────────────────────────────────────────────
# DJANGO
# ─────────────────────────────────────────────
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-secret-key-muy-largo-y-aleatorio-aqui

# En dev: DEBUG=True | En producción: DEBUG=False (lo maneja settings/prod.py)
DJANGO_SETTINGS_MODULE=core.settings.dev

# Hosts permitidos separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Orígenes CORS permitidos (frontend React + Vite)
# Vite usa 5173 por defecto, pero si el puerto está ocupado prueba 5174, 5175...
# Si el frontend arranca en un puerto no listado aqui, el login "funciona" pero
# el resto de peticiones (stats, campaigns) fallan con error de CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000


# ─────────────────────────────────────────────
# POSTGRESQL — Neon.tech (producción)
# Para desarrollo local: apunta al contenedor postgres
# ─────────────────────────────────────────────
DB_NAME=marketmind_db
DB_USER=marketmind_user
DB_PASSWORD=tu-password-seguro-aqui
DB_HOST=localhost
# En Neon.tech: DB_HOST=ep-xxxx.us-east-1.aws.neon.tech
DB_PORT=5432
DB_SSLMODE=prefer
# En Neon.tech: DB_SSLMODE=require


# ─────────────────────────────────────────────
# REDIS — Celery broker (preparado para Sprint 2)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0


# ─────────────────────────────────────────────
# N8N — Configuración del servidor de workflows
# ─────────────────────────────────────────────
# URL pública de n8n (usar ngrok en desarrollo)
# En producción: URL del servidor n8n desplegado
N8N_WEBHOOK_URL=http://localhost:5678
SPRINGBOOT_INTERNAL_URL=http://localhost:8080
INTERNAL_EVENT_TOKEN=dev-internal-event-token

# Secreto compartido Django ↔ n8n (y Spring → n8n para los emails), enviado en
# el encabezado X-NexoMark-Token. Mismo valor en Django, Spring y n8n; en local,
# también en el .env raíz (docker-compose se lo pasa a n8n y a Spring).
# En producción es obligatorio: valor propio de al menos 32 caracteres.
# Generar con: openssl rand -hex 32
N8N_WEBHOOK_TOKEN=dev-n8n-webhook-token

# Credenciales del panel de n8n (Basic Auth)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=tu-password-n8n-aqui

# Clave para encriptar credenciales almacenadas en n8n
# Generar con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=tu-clave-encriptacion-n8n-aqui


# ─────────────────────────────────────────────
# GEMINI — Google AI Studio (HU4)
# Obtener en: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy-tu-api-key-de-google-ai-studio
# True para desarrollo (no consume cuota de Gemini), False en producción
USE_MOCK_AI=False


# ─────────────────────────────────────────────
# RESEND — Email transaccional (activo en Sprint 4)
# Obtener en: https://resend.com/api-keys
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@marketmind.ai
# Correo de recuperación de contraseña: Django lo envía por el SMTP de Resend
# (smtp.resend.com:587, usuario "resend", contraseña = RESEND_API_KEY).
# En dev.py se usa la consola: el enlace aparece en la terminal de runserver.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=NexoMark IA <noreply@tu-dominio-verificado.com>


# ─────────────────────────────────────────────
# META — Publicar en Instagram y Facebook (Fase 3)
# App de developers.facebook.com en modo desarrollo; ver docs/guia-meta-cuentas-demo.md
# ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Solo si la app usa "Inicio de sesión con Facebook para empresas": ID de la configuración
META_LOGIN_CONFIG_ID=
# Debe coincidir con la URI de redirección registrada en la app de Meta
META_REDIRECT_URI=http://localhost:8000/api/social/meta/callback/
# Dirección pública HTTPS (túnel o despliegue) desde donde Meta descarga las imágenes
PUBLIC_BASE_URL=
# Adónde vuelve el navegador después de conectar la cuenta
FRONTEND_URL=http://localhost:5173
# Clave Fernet para cifrar tokens de página. Obligatoria en producción.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOCIAL_TOKEN_KEY=
# Token de prueba del Explorador de la API Graph, solo para scripts/meta/prueba_meta.py
META_ACCESS_TOKEN=


# ─────────────────────────────────────────────
# GOOGLE — Entrar y registrarse con Google (web y app). Sin Client ID no aparece el botón
# Google Cloud → Clients: uno "Web application" (este valor) y, para la app, uno
# Android (paquete com.marketmind.nexomark + SHA-1) y uno iOS (bundle com.marketmind.nexomark)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
# Client ID de Android e iOS separados por coma (también se aceptan como audiencia del ID token)
GOOGLE_CLIENT_IDS_NATIVOS=


# ─────────────────────────────────────────────
# X (Twitter) — OPCIONAL, apagada por defecto
# La API de X es de pago por uso: publicar cuesta ~US$0.015 por post
# (US$0.200 si lleva enlace; NexoMark no deja publicar enlaces) y leer el
# usuario al conectar ~US$0.010. Fija también un spending limit en console.x.com.
# ─────────────────────────────────────────────
X_HABILITADO=False
# OAuth 2.0 de la app (Client ID y Client Secret, no la Consumer Key ni el Bearer Token)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Debe coincidir con una callback URL registrada en la app de X
X_REDIRECT_URI=http://localhost:8000/api/social/x/callback/
# Costo estimado por publicación y tope de gasto mensual en USD (0.30 = 20 posts)
X_COSTO_POST_USD=0.015
X_COSTO_LECTURA_USD=0.010
X_TOPE_MENSUAL_USD=0.30


# ─────────────────────────────────────────────
# PRODUCCIÓN — Solo para Render.com (Sprint 4)
# ─────────────────────────────────────────────
# RENDER_EXTERNAL_URL=https://marketmind-api.onrender.com
# VERCEL_FRONTEND_URL=https://marketmind-ia.vercel.app
