# ============================================================
# MarketMind IA — Variables de Entorno
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitear el .env al repositorio.
# Google Identity Services: Client ID OAuth de tipo Web (sin Client Secret).
# Configurar los orígenes autorizados; ver GOOGLE_LOGIN_SETUP.md.
GOOGLE_CLIENT_ID=
# ============================================================


# ─────────────────────────────────────────────
# DJANGO
# ─────────────────────────────────────────────
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=tu-secret-key-muy-largo-y-aleatorio-aqui

# En dev: DEBUG=True | En producción: DEBUG=False (lo maneja settings/prod.py)
DJANGO_SETTINGS_MODULE=core.settings.dev

# Hosts permitidos separados por coma
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Orígenes CORS permitidos (frontend React + Vite)
# Vite usa 5173 por defecto, pero si el puerto está ocupado prueba 5174, 5175...
# Si el frontend arranca en un puerto no listado aqui, el login "funciona" pero
# el resto de peticiones (stats, campaigns) fallan con error de CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000


# ─────────────────────────────────────────────
# POSTGRESQL — Neon.tech (producción)
# Para desarrollo local: apunta al contenedor postgres
# ─────────────────────────────────────────────
DB_NAME=marketmind_db
DB_USER=marketmind_user
DB_PASSWORD=tu-password-seguro-aqui
DB_HOST=localhost
# En Neon.tech: DB_HOST=ep-xxxx.us-east-1.aws.neon.tech
DB_PORT=5432
DB_SSLMODE=prefer
# En Neon.tech: DB_SSLMODE=require


# ─────────────────────────────────────────────
# REDIS — Celery broker (preparado para Sprint 2)
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0


# ─────────────────────────────────────────────
# N8N — Configuración del servidor de workflows
# ─────────────────────────────────────────────
# URL pública de n8n (usar ngrok en desarrollo)
# En producción: URL del servidor n8n desplegado
N8N_WEBHOOK_URL=http://localhost:5678
DJANGO_BASE_URL=http://host.docker.internal:8000
SPRINGBOOT_INTERNAL_URL=http://localhost:8081

# Correo de recuperación (consola hasta configurar SMTP).
FRONTEND_BASE_URL=http://localhost:5173
# Instagram Login: credenciales de la app de INSTAGRAM, no de Facebook.
# El retorno debe ser el mismo origen HTTPS donde el marketero inició sesión.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_FRONTEND_ORIGIN=
# Fernet: clave independiente de SECRET_KEY. No perderla ni subirla a Git.
SOCIAL_TOKEN_ENCRYPTION_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=NexoMark IA <correo-del-proyecto@example.com>
INTERNAL_EVENT_TOKEN=

# Credenciales del panel de n8n (Basic Auth)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=tu-password-n8n-aqui

# Clave para encriptar credenciales almacenadas en n8n
# Generar con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=tu-clave-encriptacion-n8n-aqui


# ─────────────────────────────────────────────
# GEMINI — Google AI Studio (HU4)
# Obtener en: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=<YOUR_API_KEY>
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPTION_TIMEOUT=45
# True para desarrollo (no consume cuota de Gemini), False en producción
USE_MOCK_AI=False


# ─────────────────────────────────────────────
# RESEND — Email transaccional (activo en Sprint 4)
# Obtener en: https://resend.com/api-keys
# ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@marketmind.ai


# ─────────────────────────────────────────────
# PRODUCCIÓN — Solo para Render.com (Sprint 4)
# ─────────────────────────────────────────────
# RENDER_EXTERNAL_URL=https://marketmind-api.onrender.com
# VERCEL_FRONTEND_URL=https://marketmind-ia.vercel.app

# Facebook Pages OAuth (app principal de Meta, no el producto Instagram)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_LOGIN_CONFIG_ID=
# Activar solo tras añadir pages_read_user_content en Meta; luego reconectar la Página.
FACEBOOK_METRICS_PERMISSIONS=false

# X OAuth 2.0: credenciales de Client ID/Client Secret, no Consumer Key.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://TU-DOMINIO.ngrok-free.dev/api/auth/x/callback/

# TikTok Login Kit Web: usar credenciales del Sandbox para pruebas.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://TU-DOMINIO.ngrok-free.dev/api/auth/tiktok/callback/
# Prefijo de imágenes servido por el bridge. Activar solo después de verificarlo en TikTok.
TIKTOK_MEDIA_BASE_URL=https://TU-DOMINIO.ngrok-free.dev/api/tiktok/media/
TIKTOK_MEDIA_VERIFIED=false
# Ruta privada al .txt exacto descargado del portal; no copiar su contenido al repo.
TIKTOK_VERIFICATION_FILE=
# Activar después de añadir video.list en Scopes del mismo Sandbox; reconectar.
TIKTOK_METRICS_PERMISSIONS=false
